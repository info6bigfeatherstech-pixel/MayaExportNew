# ─── Server ──────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── MongoDB Atlas ────────────────────────────────────────
# Replace with your actual connection string from MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/maya_exports?retryWrites=true&w=majority

# ─── Redis ────────────────────────────────────────────────
# Local Redis:   redis://127.0.0.1:6379
# Redis Cloud:   redis://:<password>@<host>:<port>
REDIS_URL=redis://127.0.0.1:6379

# ─── CORS ─────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Rate Limiting ────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# ─── Upload ───────────────────────────────────────────────
MAX_FILE_SIZE_MB=5
UPLOAD_DIR=uploads

# ─── JWT (reserved for future auth) ─────────────────────
JWT_SECRET=replace_with_a_strong_random_secret_at_least_64_chars
JWT_EXPIRES_IN=7d
